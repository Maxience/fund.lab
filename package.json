{
  "name": "chalandise",
  "version": "0.1.0",
  "private": true,
  "description": "Outil d'étude de chalandise FUND.lab pour projets de restauration, snack et salon de thé.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:generer": "prisma generate",
    "db:migrer": "prisma migrate deploy",
    "db:migrer:dev": "prisma migrate dev",
    "db:semer": "tsx prisma/seed.mts",
    "db:studio": "prisma studio",
    "auth:verifier": "tsx scripts/verifier-acces-expert.mts",
    "auth:creer": "tsx scripts/creer-expert.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tirets": "node scripts/verifier-tirets.mjs",
    "exporter:pdf": "node scripts/exporter-pdf.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "verifier": "npm run typecheck && npm run lint && npm run format:check && npm run tirets && npm run test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "marked": "^18.0.11",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
