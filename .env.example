# Copier ce fichier vers .env puis renseigner les valeurs.
# Le fichier .env contient les secrets et reste hors du dépôt ; seul ce modèle est versionné.
# Toute nouvelle variable est ajoutée ici dans le même commit que le code qui la lit.

# Base PostgreSQL (à partir de la phase 3) : comptes Expert, études, scénarios, résultats.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/chalandise"

# Compte Expert créé par le seed de démonstration (npm run db:semer).
# Le mot de passe est haché avant enregistrement ; changez-le après la première connexion.
EXPERT_EMAIL_INITIAL="expert@exemple.test"
EXPERT_NOM_INITIAL="Expert FUND.lab"
EXPERT_MOT_DE_PASSE_INITIAL="changez-ce-mot-de-passe"

# Durée de vie d'une session Expert, en jours.
SESSION_DUREE_JOURS="7"
