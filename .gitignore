# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# client Prisma généré
/src/generated

# documents PDF et HTML generes par npm run exporter:pdf (la source reste le Markdown)
/livrables

# fichiers generes par next dev pour les agents IA (voir AGENTS.md)
/AGENTS.md

# configuration personnelle de l'assistant, hors perimetre du depot
/CLAUDE.md

# documents confidentiels FUND.lab (brief, etc.) : ne jamais committer
*.pdf
